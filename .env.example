# Local development: no database configuration required (data/encopa.db).
# Vercel: provision a Turso libSQL database and configure these server-only values.
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=
# Required in production for organizers to create a group. Use a long random value.
ENCOPA_CREATE_KEY=
# Canonical deployed origin, e.g. https://encopa.example.com (no trailing path)
APP_ORIGIN=
# Optional: local venue ranking still works without this key.
ORCAROUTER_API_KEY=
# Per-client hourly ceiling, so one caller cannot drain the daily budget. Default 40.
ENCOPA_AI_CLIENT_HOURLY_LIMIT=40
# Site-wide Orca request ceiling per UTC day. Fallback after reaching it.
ENCOPA_AI_DAILY_LIMIT=100
# Set to 1 to send provider-side prompt cache markers. Leave off unless the routed models
# reach the provider's minimum cacheable prefix; see docs/AUDIT-2026-09.md.
ENCOPA_AI_PROMPT_CACHE=0
