# Local development: no database configuration required (data/encopa.db).
# Vercel: provision a Turso libSQL database and configure these server-only values.
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=
# 32-byte key as 64 hex characters or base64. Encrypts reservations and allergy data at rest.
ENCOPA_DATA_KEY=
# Canonical deployed origin, e.g. https://encopa.example.com (no trailing path)
APP_ORIGIN=
# Required for real restaurant search. Keep server-only (no NEXT_PUBLIC_ prefix).
HOTPEPPER_API_KEY=
# Required for agent planning. Hosted default: https://api.orcarouter.ai/v1
ORCAROUTER_API_KEY=
ORCAROUTER_BASE_URL=https://api.orcarouter.ai/v1
# Comma-separated additional hosts only when using a trusted self-hosted router.
ORCAROUTER_ALLOWED_HOSTS=
ORCAROUTER_MODEL=auto
# Maximum planning requests per UTC-day (one standard request uses one routed call; detailed review uses up to four).
ENCOPA_AGENT_DAILY_LIMIT=100
# Maximum detailed reviews per UTC-day. Each detailed review adds up to three routed calls.
ENCOPA_AGENT_DETAILED_DAILY_LIMIT=30
# Planning requests per hour from one client address. Default 10.
ENCOPA_AGENT_IP_HOURLY_LIMIT=10
# How long routed calls stop after three consecutive failures, in ms. Default 60000.
ENCOPA_AGENT_BREAKER_COOLDOWN_MS=60000
